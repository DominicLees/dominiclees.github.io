doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(property="og:title" content="Dom's Blog")
        meta(property="og:description" content="Hi I'm Dom and this is my blog")
        meta(property="og:url" content="https://dominiclees.github.io/")
        meta(property="og:type" content="website")
        title Dom's Blog
        link(rel="stylesheet", href="styles/master.css")
        link(rel="stylesheet", href="styles/index.css") 
    body
        include ../templates/navbar.pug
        //- TODO: Put some welcome content here
        main
            for article in articles
                div
                    a(href=`./post/${article.filename}`) 
                        h2= article.title
                        p= article.subtitle